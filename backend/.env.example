PORT=5000
NODE_ENV=development
# Docker db maps host 5433 to container 5432 to avoid colliding with local PostgreSQL.
DATABASE_URL=postgresql://traveloop_user:traveloop_pass@localhost:5433/traveloop
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
